[Unit]
Description=Mimic acoustic-cache daemon
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mimicd --config %h/.config/mimic/config.toml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/mimic
UMask=0077

[Install]
WantedBy=default.target
